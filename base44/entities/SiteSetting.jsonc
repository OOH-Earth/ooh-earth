{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key, e.g. themes_enabled"
    },
    "value": {
      "type": "string",
      "description": "Setting value (e.g. comma-separated theme ids)"
    },
    "description": {
      "type": "string",
      "description": "Optional description (max 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}