{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "access": {
      "type": "string",
      "description": "Field-operations access level",
      "enum": [
        "admin",
        "moderator",
        "member"
      ],
      "default": "member",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "agency": {
      "type": "boolean",
      "description": "Whether the user is an agency member who can tag and edit locations",
      "default": false,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "founding_member": {
      "type": "boolean",
      "description": "Founding Member status for the public profile. Admin-granted only -- a member can author their own bio/region/focus_areas via auth.updateMe, but can never self-declare founding status.",
      "default": false,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}
