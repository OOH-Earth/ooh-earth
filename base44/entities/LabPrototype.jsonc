{
  "name": "LabPrototype",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "Route path, e.g. /lab/coin"
    },
    "title": {
      "type": "string"
    },
    "access": {
      "type": "string",
      "enum": [
        "public",
        "restricted"
      ],
      "default": "restricted",
      "description": "public = anyone; restricted = investor token OR authenticated account"
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "in_build"
      ],
      "default": "live"
    },
    "visible": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "path",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}