{
  "name": "StoreItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Product or document title"
    },
    "subtitle": {
      "type": "string",
      "description": "Short tagline / edition line"
    },
    "description": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Markdown body for library / research docs"
    },
    "category": {
      "type": "string",
      "enum": [
        "library",
        "plugin",
        "uikit",
        "theme",
        "nft",
        "physical"
      ],
      "default": "library",
      "description": "Library = research/docs; rest = digital products, NFT drops, physical prototypes"
    },
    "price_usd": {
      "type": "number",
      "default": 0,
      "description": "0 = free download"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "free",
        "upcoming",
        "sold_out"
      ],
      "default": "available"
    },
    "image_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Deliverable download URL for digital / free items"
    },
    "external_url": {
      "type": "string",
      "description": "External buy / drop URL (Zora mint, mschf drop, etc.)"
    },
    "edition_size": {
      "type": "number",
      "description": "Limited edition count; omit for unlimited"
    },
    "edition_sold": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "category",
    "price_usd"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}