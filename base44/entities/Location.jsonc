{
  "name": "Location",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short label, e.g. 'Billboard \u00b7 1039 Pleonchit'"
    },
    "type": {
      "type": "string",
      "enum": [
        "billboard",
        "painted",
        "digital",
        "projection",
        "sticker",
        "mural",
        "transit",
        "other"
      ],
      "default": "other"
    },
    "address": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "source_link": {
      "type": "string",
      "description": "External detail URL (ooh.earth post, news, etc.)"
    },
    "notes": {
      "type": "string"
    },
    "access_key": {
      "type": "string",
      "enum": [
        "none",
        "4-way-utility",
        "cemusapin",
        "circle",
        "circle-set",
        "circle-wall",
        "h60",
        "jcd-superlock",
        "large-square",
        "small-square",
        "t-handle",
        "unknown"
      ],
      "default": "none",
      "description": "Physical access key type that opens the unit housing (see ooh.earth/access-keys)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "title",
    "lat",
    "lng"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.status": "verified"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}