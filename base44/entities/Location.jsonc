{
  "name": "Location",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Short label, e.g. 'Billboard \u00b7 1039 Pleonchit'"
    },
    "type": {
      "type": "string",
      "enum": [
        "billboard",
        "painted",
        "digital",
        "projection",
        "sticker",
        "mural",
        "transit",
        "other"
      ],
      "default": "other"
    },
    "address": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "source_link": {
      "type": "string",
      "description": "External detail URL"
    },
    "notes": {
      "type": "string"
    },
    "access_key": {
      "type": "string",
      "enum": [
        "none",
        "4-way-utility",
        "cemusapin",
        "circle",
        "circle-set",
        "circle-wall",
        "h60",
        "jcd-superlock",
        "large-square",
        "small-square",
        "t-handle",
        "unknown"
      ],
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending"
    },
    "brand_name": {
      "type": "string",
      "description": "Brand / advertiser being promoted, e.g. Shell, McDonald's"
    },
    "ooh_operator": {
      "type": "string",
      "description": "OOH media company that owns the structure, e.g. Clear Channel, Plan B"
    },
    "ad_agency": {
      "type": "string",
      "description": "Creative agency that produced the campaign, e.g. Ogilvy, BBDO"
    },
    "campaign_name": {
      "type": "string",
      "description": "Campaign or tagline name, e.g. 'Drive the Future'"
    },
    "parent_corp": {
      "type": "string",
      "description": "Parent / holding company, e.g. WPP, Shell plc"
    },
    "industry_sector": {
      "type": "string",
      "enum": [
        "fossil_fuel",
        "tobacco",
        "alcohol",
        "gambling",
        "ultra_processed_food",
        "surveillance",
        "finance",
        "real_estate",
        "fashion",
        "automotive",
        "pharma",
        "other"
      ],
      "description": "Industry sector of the advertiser"
    },
    "harm_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Harm classification tags, e.g. greenwashing, child_targeting"
    },
    "condition": {
      "type": "string",
      "enum": [
        "functional",
        "neglected",
        "damaged",
        "abandoned",
        "reclaimed",
        "upgraded"
      ],
      "default": "functional",
      "description": "Infrastructure condition of the OOH unit"
    },
    "adbust_type": {
      "type": "string",
      "enum": [
        "none",
        "subverted",
        "painted_over",
        "stickered",
        "projected",
        "wheatpasted",
        "removed",
        "other"
      ],
      "default": "none",
      "description": "Type of activist intervention, if any"
    },
    "adbust_image_url": {
      "type": "string",
      "description": "Photo of the adbust / subvertised state"
    },
    "harm_statement": {
      "type": "string",
      "description": "Community statement: what this ad is doing to this space / community"
    },
    "action_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Action intents: legal_review, council_submission, community_reclaim, petition, archive"
    }
  },
  "required": [
    "title",
    "lat",
    "lng"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.status": "verified"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}