{
  "name": "FundingLead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Pledged amount in USD (optional)"
    },
    "channel": {
      "type": "string",
      "enum": [
        "lead",
        "crypto",
        "stripe"
      ],
      "default": "lead"
    },
    "message": {
      "type": "string"
    },
    "ext_ref": {
      "type": "string",
      "description": "External reference (e.g. Stripe session id) \u2014 used for webhook idempotency"
    },
    "description": {
      "type": "string",
      "description": "Optional description (max 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}