{
  "name": "QuestCompletion",
  "type": "object",
  "properties": {
    "quest_id": {
      "type": "string",
      "description": "Quest identifier, e.g. daily_report, weekly_mint"
    },
    "period_key": {
      "type": "string",
      "description": "Time window key: YYYY-MM-DD for daily, YYYY-WNN for weekly"
    },
    "xp_awarded": {
      "type": "number",
      "default": 0,
      "description": "Bonus XP granted on claim"
    },
    "description": {
      "type": "string",
      "description": "Optional description (max 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "quest_id",
    "period_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}