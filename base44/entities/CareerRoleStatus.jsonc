{
  "name": "CareerRoleStatus",
  "type": "object",
  "properties": {
    "role_id": {
      "type": "string",
      "description": "Matches the id of a role in src/components/ooh/careers/roles.js"
    },
    "title": {
      "type": "string",
      "description": "Cached role title, for readability in the admin console"
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "future",
        "filled",
        "draft"
      ],
      "default": "future",
      "description": "live = open now, apply \u00b7 future = registered interest only \u00b7 filled = closed \u00b7 draft = hidden from public page"
    },
    "visible": {
      "type": "boolean",
      "default": true,
      "description": "false = fully hidden from the public /careers page, regardless of status"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "role_id",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}