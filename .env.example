# Environment variables this repo actually reads — verified by grepping
# `import.meta.env.VITE_*` in src/ and `Deno.env.get(...)` in
# base44/functions/, not written from memory. Copy to .env.local for
# frontend-only local dev; see below for where backend vars actually live.

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Read by src/lib/app-params.js. Only needed if you're pointing a local
# frontend at a specific Base44 app/backend instead of the default hosted
# one — see AGENTS.md for when `base44 dev` vs `npm run dev` applies.
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=

# ── Backend (Deno functions, base44/functions/*/entry.ts) ───────────────
# These are NOT read from a local .env file at runtime — Deno functions run
# inside Base44, so real values live in Base44 Secrets, never here and never
# committed (SECURITY.md, CLAUDE.md rule #4). Listed here so a new
# contributor knows what exists and where to find/set each one, and so a
# missing-secret failure is recognizable instead of mysterious.

# base44/functions/createDonationCheckout, createProductCheckout, n8nPing
BASE44_APP_ID=

# base44/functions/createDonationCheckout, createProductCheckout
STRIPE_SECRET_KEY=

# base44/functions/stripeWebhook — verifies the Stripe webhook signature;
# missing this fails closed (401 on every webhook call), not open.
STRIPE_WEBHOOK_SECRET=

# base44/functions/investorAccess — the investor-area gate. Missing either
# of these fails closed (503 "not configured"), never falls back to a
# default (fixed 2026-08-11 — see that file's own header comment).
INVESTOR_ACCESS_CODE=
INVESTOR_TOKEN_SECRET=

# base44/functions/n8nPing — shared-secret pattern for the n8n webhook
# bridge test endpoint (dev/ops only, no frontend caller).
N8N_PING_KEY=
N8N_WEBHOOK_URL=

# base44/functions/personaCtl — admin-only identity/clearance controller;
# alternate auth path via X-Persona-Key header (same fail-closed pattern).
PERSONA_KEY=
