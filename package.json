{
  "name": "base44-app",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-meta.mjs && node scripts/generate-release-manifest.mjs dist/release-manifest.json",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:evidence": "node scripts/release-evidence.mjs",
    "release:status": "node scripts/release.mjs status",
    "release:plan": "node scripts/release.mjs plan",
    "release:transition": "node scripts/release.mjs transition",
    "release:backup": "node scripts/release.mjs deploy:backup",
    "release:production": "node scripts/release.mjs deploy:production",
    "release:publish:backup": "node scripts/release.mjs publish:backup",
    "release:publish:production": "node scripts/release.mjs publish:production",
    "entities:preflight:backup": "node scripts/base44-entity-preflight.mjs backup",
    "entities:preflight:production": "node scripts/base44-entity-preflight.mjs production",
    "test:entities-preflight": "node --test scripts/base44-entity-preflight.test.mjs",
    "test:release": "node --test scripts/release-state.test.mjs",
    "test:release-utils": "node --test scripts/release-utils.test.mjs",
    "test:release-evidence": "node --test scripts/release-evidence.test.mjs",
    "test:jarvis": "node --test src/lib/jarvisReasoning.test.js",
    "test:autopilot": "node --test src/lib/autopilotReasoning.test.js",
    "test:production-truth": "node --test src/lib/productionTruth.test.js",
    "test:transaction-integrity": "node --test src/lib/transactionIntegrity.test.js",
    "test:location-quality": "node --test src/lib/locationQuality.test.js",
    "test:geospatial-intelligence": "node --test src/lib/geospatialIntelligence.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:security-functions": "node scripts/server-function-security-check.mjs",
    "test:server-functions": "./node_modules/.bin/deno test --no-check base44/functions/tests/security.test.ts",
    "typecheck:functions": "cd base44/functions && deno check --node-modules-dir=none */entry.ts"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.42",
    "@base44/vite-plugin": "^1.0.30",
    "@hello-pangea/dnd": "^17.0.0",
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.5.2",
    "exifr": "^7.1.3",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.24.0",
    "moment": "^2.30.1",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.85.0",
    "react-hot-toast": "^2.6.0",
    "react-is": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.11.14",
    "deno": "2.9.5",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  }
}
